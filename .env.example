# Project Environment Configurations
# Copy this file to .env and adjust variables as required.

# Environment Mode
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Secure Banking API & AI Fraud Pipeline"
API_V1_STR=/api/v1

# Security & JWT Configuration
# Generate a strong 32+ byte secret: `openssl rand -hex 32`
JWT_SECRET_KEY=change-this-in-production-to-a-super-secret-hex-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=banking_secure_pass
POSTGRES_DB=banking_db
# Async connection URL for asyncpg / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://banking_user:banking_secure_pass@localhost:5432/banking_db
# Sync connection URL for migrations / Alembic
DATABASE_URL_SYNC=postgresql://banking_user:banking_secure_pass@localhost:5432/banking_db

# Redis Configuration (Session caching, rate limiting, feature cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_DEFAULT="100/minute"

# Streaming & Event Bus Configuration (Kafka / RabbitMQ)
STREAMING_BROKER_TYPE=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=banking.transactions.v1
KAFKA_ALERTS_TOPIC=banking.fraud.alerts.v1
KAFKA_CONSUMER_GROUP=fraud-scoring-group

# Alternative: RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_TRANSACTION_QUEUE=banking.transactions.queue

# Machine Learning & Fraud Pipeline Config
ML_MODEL_DIR=ml_pipeline/artifacts
XGBOOST_MODEL_FILE=xgboost_fraud_model.json
ISOLATION_FOREST_FILE=isolation_forest_model.joblib
SHAP_BACKGROUND_DATA_FILE=shap_background.joblib

# Risk Thresholds (0 - 100)
RISK_THRESHOLD_LOW=30.0
RISK_THRESHOLD_HIGH=70.0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]
